# Copy this file to .env and fill in real values. Never commit .env.

# Server
PORT=5000
NODE_ENV=development

# MongoDB connection string (MongoDB Atlas or local mongod)
MONGO_URI=mongodb://127.0.0.1:27017/gurukul

# JWT secrets - use long random strings in production
# Generate one quickly with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_a_long_random_refresh_secret

# Token lifetimes
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins (for CORS + cookies)
CLIENT_ORIGIN=http://localhost:5173
